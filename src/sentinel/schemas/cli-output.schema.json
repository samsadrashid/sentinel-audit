    "compare": {
      "type": "object",
      "properties": {
        "exit_code": {
          "type": "integer",
          "minimum": 0,
          "maximum": 7
        },
        "comparison": {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "enum": [
                "sentinel-compare"
              ]
            },
            "compare_version": {
              "type": "integer",
              "enum": [
                3
              ]

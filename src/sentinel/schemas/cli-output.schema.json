                  "type": "string",
                  "maxLength": 32
                }
              },
              "required": [
                "manifest_sha256",
                "overall",
                "run_id"
              ],
              "additionalProperties": false
            },
            "after": {
              "type": "object",
              "properties": {
                "run_id": {
                  "type": "string",
                  "maxLength": 64
                },
                "manifest_sha256": {
                  "$ref": "common.schema.json#/$defs/hex64"
                },
                "overall": {
                  "type": "string",
                  "maxLength": 32
                }
              },
              "required": [
                "manifest_sha256",
                "overall",
                "run_id"
              ],
              "additionalProperties": false
            },
            "introduced": {
              "type": "array",
              "items": {
                "type": "object"
              }
            },
            "fixed": {
              "type": "array",
              "items": {
                "type": "object"
              }
            },
            "unverified": {
              "type": "array",
              "items": {
                "type": "object"
              }
            },
            "persisting": {
              "type": "array",
              "items": {
                "type": "object"
              }
            },
            "remediation": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "finding": {
                    "$ref": "common.schema.json#/$defs/hex64"
                  },
                  "severity": {
                    "type": "string",
                    "maxLength": 16
                  },
                  "status": {
                    "type": "string",
                    "enum": [
                      "resolved",
                      "open",
                      "accepted",
                      "unverified"
                    ]
                  },
                  "evidence_before": {
                    "type": "array",
                    "maxItems": 1000,
                    "items": {
                      "$ref": "common.schema.json#/$defs/hex64"
                    }
                  },
                  "evidence_after": {
                    "type": "array",
                    "maxItems": 1000,
                    "items": {
                      "$ref": "common.schema.json#/$defs/hex64"
                    }
                  }
                },
                "required": [
                  "evidence_after",
                  "evidence_before",
                  "finding",
                  "severity",
                  "status"
                ],
                "additionalProperties": false
              }
            },
            "risk": {
              "type": "object",
              "properties": {
                "before": {
                  "type": "object",
                  "properties": {
                    "open_by_severity": {
                      "type": "object"
                    },
                    "open_by_domain": {
                      "type": "object"
                    },
                    "accepted": {
                      "type": "integer",
                      "minimum": 0
                    },
                    "weighted_score": {
                      "type": "integer",
                      "minimum": 0
                    }
                  },
                  "required": [
                    "accepted",
                    "open_by_domain",
                    "open_by_severity",
                    "weighted_score"
                  ],
                  "additionalProperties": false
                },
                "after": {
                  "type": "object",
                  "properties": {
                    "open_by_severity": {
                      "type": "object"
                    },
                    "open_by_domain": {
                      "type": "object"
                    },
                    "accepted": {
                      "type": "integer",
                      "minimum": 0
                    },
                    "weighted_score": {
                      "type": "integer",
                      "minimum": 0
                    }
                  },
                  "required": [
                    "accepted",
                    "open_by_domain",
                    "open_by_severity",
                    "weighted_score"
                  ],
                  "additionalProperties": false
                }
              },
              "required": [
                "after",
                "before"
              ],
              "additionalProperties": false
            },
            "checks_not_completed_after": {
              "type": "array",
              "items": {
                "type": "string",
                "maxLength": 4096
              }
            },
            "note": {
              "type": "string",
              "maxLength": 4096
            }
          },
          "required": [
            "after",
            "before",
            "checks_not_completed_after",
            "compare_version",
            "fixed",
            "introduced",
            "kind",
            "note",
            "persisting",
            "remediation",
            "risk",
            "unverified"
          ],
          "additionalProperties": false
        },
        "comparison_sha256": {
          "$ref": "common.schema.json#/$defs/hex64"
        }
      },
      "required": [
        "comparison",
        "comparison_sha256",
        "exit_code"
      ],
      "additionalProperties": false
    },

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:sentinel:schema:common:v1",
  "title": "Shared Sentinel definitions (no root instance)",
  "$defs": {
    "hex64": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "nonce": {
      "type": "string",
      "pattern": "^[0-9a-f]{32}$"
    },
    "key_id": {
      "type": "string",
      "pattern": "^(?:ed25519|p256):[0-9a-f]{32}$"
    },
    "store_audit_id": {
      "type": "string",
      "pattern": "^[0-9a-f-]{1,64}$",
      "$comment": "RunStore.create character rule"
    },
    "run_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "base64": {
      "type": "string",
      "maxLength": 8192,
      "pattern": "^[A-Za-z0-9+/]*={0,2}$"
    },
    "hexstring": {
      "type": "string",
      "maxLength": 8192,
      "pattern": "^[0-9a-f]*$"
    },
    "text": {
      "type": "string",
      "maxLength": 4096
    },
    "long_text": {
      "type": "string",
      "maxLength": 65536
    },
    "unix_seconds": {
      "type": "integer",
      "minimum": 0
    },
    "schema_version_1": {
      "type": "string",
      "const": "1.0"
    },
    "operator_algorithm": {
      "type": "string",
      "enum": [
        "ed25519",
        "ecdsa-p256-sha256"
      ]
    },
    "mode": {
      "type": "string",
      "enum": [
        "READ",
        "VALIDATE"
      ]
    },
    "level": {
      "type": "string",
      "enum": [
        "L1",
        "L2",
        "L3"
      ]
    },
    "activity_class": {
      "type": "string",
      "enum": [
        "S1",
        "S2",
        "B1",
        "B2",
        "B3",
        "A1"
      ]
    },
    "environment": {
      "type": "string",
      "enum": [
        "local",
        "staging",
        "production"
      ]
    },
    "check_status": {
      "type": "string",
      "enum": [
        "PASS",
        "FAIL",
        "NOT_RUN",
        "BLOCKED",
        "ERROR",
        "NOT_APPLICABLE"
      ]
    },
    "audit_state": {
      "type": "string",
      "enum": [
        "Created",
        "Planned",
        "Authorized",
        "Blocked",
        "Running",
        "Paused",
        "Cancelled",
        "Completed",
        "Incomplete",
        "Reported"
      ]
    },
    "overall": {
      "type": "string",
      "enum": [
        "PASS",
        "FAIL",
        "INCOMPLETE",
        "BLOCKED",
        "CANCELLED",
        "CREATED",
        "PLANNED",
        "AUTHORIZED",
        "RUNNING",
        "PAUSED",
        "REPORTED"
      ]
    },
    "severity": {
      "type": "string",
      "enum": [
        "critical",
        "high",
        "medium",
        "low",
        "informational"
      ]
    },
    "confidence": {
      "type": "string",
      "enum": [
        "high",
        "medium",
        "low"
      ]
    },
    "finding_state": {
      "type": "string",
      "enum": [
        "unverified",
        "suspected",
        "verified",
        "HUMAN_VERIFIED_NO_DETERMINISTIC_EVIDENCE",
        "false_positive",
        "accepted_risk"
      ]
    },
    "finding_origin": {
      "type": "string",
      "enum": [
        "scanner",
        "agent",
        "model"
      ]
    },
    "approval_action": {
      "type": "string",
      "enum": [
        "authorize_record",
        "revoke_record",
        "review.verify_no_evidence",
        "review.accept_risk",
        "suppress",
        "policy.change",
        "key.rotate",
        "key.revoke",
        "release.publish"
      ]
    },
    "approval_context": {
      "type": "string",
      "pattern": "^sentinel/v1/approval/(?:authorize_record|revoke_record|review\\.verify_no_evidence|review\\.accept_risk|suppress|policy\\.change|key\\.rotate|key\\.revoke|release\\.publish)$"
    },
    "string_list": {
      "type": "array",
      "items": {
        "type": "string",
        "maxLength": 4096
      },
      "maxItems": 10000
    },
    "json_object": {
      "type": "object"
    },
    "limits": {
      "type": "object",
      "properties": {
        "scanner_timeout_s": {
          "type": "integer",
          "minimum": 1
        },
        "max_audit_duration_s": {
          "type": "integer",
          "minimum": 1
        },
        "max_concurrent_scanners": {
          "type": "integer",
          "minimum": 1
        },
        "max_artifact_bytes": {
          "type": "integer",
          "minimum": 1
        },
        "max_extracted_total_bytes": {
          "type": "integer",
          "minimum": 1
        },
        "max_extracted_entries": {
          "type": "integer",
          "minimum": 1
        },
        "max_nested_archive_depth": {
          "type": "integer",
          "minimum": 1
        },
        "max_path_depth": {
          "type": "integer",
          "minimum": 1
        },
        "max_entry_ratio": {
          "type": "integer",
          "minimum": 1
        },
        "max_total_ratio": {
          "type": "integer",
          "minimum": 1
        },
        "max_extracted_file_bytes": {
          "type": "integer",
          "minimum": 1
        },
        "evidence_retention_days": {
          "type": "integer",
          "minimum": 1
        },
        "max_scanner_output_bytes": {
          "type": "integer",
          "minimum": 1
        }
      },
      "required": [
        "evidence_retention_days",
        "max_artifact_bytes",
        "max_audit_duration_s",
        "max_concurrent_scanners",
        "max_entry_ratio",
        "max_extracted_entries",
        "max_extracted_file_bytes",
        "max_extracted_total_bytes",
        "max_nested_archive_depth",
        "max_path_depth",
        "max_scanner_output_bytes",
        "max_total_ratio",
        "scanner_timeout_s"
      ],
      "additionalProperties": false
    },
    "limits_partial": {
      "type": "object",
      "properties": {
        "scanner_timeout_s": {
          "type": "integer",
          "minimum": 1
        },
        "max_audit_duration_s": {
          "type": "integer",
          "minimum": 1
        },
        "max_concurrent_scanners": {
          "type": "integer",
          "minimum": 1
        },
        "max_artifact_bytes": {
          "type": "integer",
          "minimum": 1
        },
        "max_extracted_total_bytes": {
          "type": "integer",
          "minimum": 1
        },
        "max_extracted_entries": {
          "type": "integer",
          "minimum": 1
        },
        "max_nested_archive_depth": {
          "type": "integer",
          "minimum": 1
        },
        "max_path_depth": {
          "type": "integer",
          "minimum": 1
        },
        "max_entry_ratio": {
          "type": "integer",
          "minimum": 1
        },
        "max_total_ratio": {
          "type": "integer",
          "minimum": 1
        },
        "max_extracted_file_bytes": {
          "type": "integer",
          "minimum": 1
        },
        "evidence_retention_days": {
          "type": "integer",
          "minimum": 1
        },
        "max_scanner_output_bytes": {
          "type": "integer",
          "minimum": 1
        }
      },
      "required": [],
      "additionalProperties": false
    },
    "scope_asset": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "maxLength": 4096
        },
        "kind": {
          "type": "string",
          "enum": [
            "local_path",
            "artifact",
            "host"
          ]
        },
        "locator": {
          "type": "string",
          "maxLength": 4096
        },
        "environment": {
          "$ref": "common.schema.json#/$defs/environment"
        }
      },
      "required": [
        "environment",
        "id",
        "kind",
        "locator"
      ],
      "additionalProperties": false
    },
    "target_asset": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "maxLength": 4096
        },
        "kind": {
          "type": "string",
          "maxLength": 4096
        },
        "environment": {
          "$ref": "common.schema.json#/$defs/environment"
        }
      },
      "required": [
        "environment",
        "id",
        "kind"
      ],
      "additionalProperties": false
    },
    "target": {
      "type": "object",
      "properties": {
        "assets": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/target_asset"
          }
        },
        "revision": {
          "type": "string",
          "maxLength": 4096
        }
      },
      "required": [
        "assets",
        "revision"
      ],
      "additionalProperties": false
    },
    "approval_payload": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "context": {
              "const": "sentinel/v1/approval/authorize_record"
            },
            "action": {
              "const": "authorize_record"
            },
            "subject": {
              "type": "object",
              "additionalProperties": {
                "type": "string",
                "maxLength": 4096
              }
            },
            "revision": {
              "type": "string",
              "maxLength": 4096
            },
            "scope": {
              "type": "object"
            },
            "issued_at": {
              "type": "integer",
              "minimum": 0
            },
            "expires_at": {
              "type": "integer",
              "minimum": 0
            },
            "nonce": {
              "$ref": "#/$defs/nonce"
            },
            "key_id": {
              "$ref": "#/$defs/key_id"
            },
            "rationale": {
              "type": "string",
              "maxLength": 4096
            }
          },
          "required": [
            "action",
            "context",
            "expires_at",
            "issued_at",
            "key_id",
            "nonce",
            "rationale",
            "revision",
            "scope",
            "subject"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {

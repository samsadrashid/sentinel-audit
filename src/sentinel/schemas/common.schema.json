    "approval_file": {
      "type": "object",
      "properties": {
        "payload": {
          "$ref": "#/$defs/approval_payload"
        },
        "signature": {
          "$ref": "#/$defs/base64"
        }
      },
      "required": [
        "payload",
        "signature"
      ],
      "additionalProperties": false
    },
    "suppress_entry": {
      "type": "object",
      "properties": {
        "kind": {
          "const": "suppress"
        },
        "finding": {
          "$ref": "#/$defs/hex64"
        },
        "revision": {
          "type": "string",
          "maxLength": 4096
        },
        "reason": {
          "type": "string",
          "maxLength": 4096
        },
        "author": {
          "type": "string",
          "maxLength": 4096
        },
        "created_at": {
          "type": "integer"
        },
        "expires_at": {
          "type": "integer"

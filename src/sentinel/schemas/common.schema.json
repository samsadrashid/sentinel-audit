              "const": "release.publish"
            },
            "subject": {
              "type": "object",
              "properties": {
                "type": {
                  "const": "release"
                },
                "name": {
                  "const": "sentinel-audit"
                },
                "version": {
                  "type": "string",
                  "pattern": "^[0-9][0-9A-Za-z.+-]{0,63}$"
                },
                "commit": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{40}$"
                }
              },
              "required": [
                "commit",
                "name",
                "type",
                "version"
              ],
              "additionalProperties": false
            },
            "revision": {
              "type": "string",
              "pattern": "^sums:[0-9a-f]{64}$"
            },
            "scope": {
              "type": "object",
              "properties": {
                "artifacts": {
                  "type": "array",
                  "minItems": 1,
                  "maxItems": 16,
                  "items": {
                    "type": "object",
                    "properties": {
                      "name": {
                        "type": "string",
                        "pattern": "^[A-Za-z0-9][A-Za-z0-9._+-]{0,199}$"
                      },
                      "sha256": {
                        "$ref": "#/$defs/hex64"
                      }
                    },
                    "required": [
                      "name",
                      "sha256"
                    ],
                    "additionalProperties": false
                  }
                }
              },
              "required": [
                "artifacts"
              ],
              "additionalProperties": false
            },
